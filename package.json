{
  "name": "app-store-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "App Store market data scraper with a local stdio MCP server",
  "type": "module",
  "main": "index.js",
  "exports": "./index.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "setup": "npm install && npm run setup:mcp",
    "build": "npm run build:mcp",
    "start": "npm run start:mcp",
    "setup:mcp": "npm --prefix packages/mcp-server install",
    "build:mcp": "npm --prefix packages/mcp-server run build",
    "start:mcp": "npm --prefix packages/mcp-server run dev",
    "test:mcp": "npm --prefix packages/mcp-server test",
    "lint:mcp": "npm --prefix packages/mcp-server run lint",
    "check:mcp": "npm --prefix packages/mcp-server run check",
    "check": "npm run lint && npm test && npm run check:secrets && npm run check:mcp",
    "test": "mocha --timeout 8000",
    "lint": "eslint .",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoldemLive/app-store-scraper.git"
  },
  "keywords": [
    "mac",
    "app",
    "store",
    "itunes",
    "scraper"
  ],
  "author": "Facundo Olano",
  "contributors": [
    "Volodymyr Shynkarov"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VoldemLive/app-store-scraper/issues"
  },
  "homepage": "https://github.com/VoldemLive/app-store-scraper#readme",
  "dependencies": {
    "cheerio": "^1.0.0-rc.2",
    "debug": "^2.2.0",
    "memoizee": "^0.4.15",
    "ramda": "^0.29.0",
    "throttled-request": "^0.1.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "chai": "^4.3.8",
    "eslint": "^8.49.0",
    "eslint-config-semistandard": "^6.0.1",
    "eslint-config-standard": "^5.1.0",
    "eslint-plugin-promise": "^1.1.0",
    "eslint-plugin-standard": "^4.0.1",
    "mocha": "^11.3.0",
    "validator": "^13.11.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
