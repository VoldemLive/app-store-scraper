# Non-secret Apple Ads configuration example.
# Keep real credentials outside the repository and provide them at runtime.
APPLE_ADS_CLIENT_ID=your-apple-ads-client-id
APPLE_ADS_TEAM_ID=your-apple-developer-team-id
APPLE_ADS_KEY_ID=your-apple-ads-key-id
APPLE_ADS_PRIVATE_KEY_PATH=/absolute/path/outside/repository/apple-ads-private-key.pem
